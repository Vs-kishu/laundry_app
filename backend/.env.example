PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/laundry_point
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# Store defaults (used until the Store document exists; edit via admin/PUT /api/store)
STORE_LAT=28.6315
STORE_LNG=77.2167
SERVICE_RADIUS_KM=15

# Pricing / ops (optional)
DELIVERY_FEE=29
FREE_DELIVERY_ABOVE=299
EXPRESS_FEE=39
EXPRESS_ETA_MINUTES=45
PARTNER_PAYOUT_PER_TASK=30

# Seed script admin (required when NODE_ENV=production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
