# Backend REST API (must end with /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Socket.IO server - defaults to NEXT_PUBLIC_API_URL without the /api suffix
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Public URL of this site: used for canonical URLs, sitemap, Open Graph and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Map tiles (optional). Default is the public OpenStreetMap server, fine for development / light use.
# For production traffic use a provider key, e.g. https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_ATTRIBUTION=
